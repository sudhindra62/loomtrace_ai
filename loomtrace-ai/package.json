{
  "name": "loomtrace-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage \"vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "deploy:docker": "bash scripts/deploy-docker.sh"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.6.3",
    "firebase": "11.0.2",
    "firebase-admin": "13.0.1",
    "zod": "3.23.8",
    "@tanstack/react-query": "5.59.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.462.0",
    "next-themes": "0.4.3",
    "react-hook-form": "7.53.2",
    "@hookform/resolvers": "3.9.1",
    "tailwind-merge": "2.5.4",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "next-intl": "3.25.1",
    "recharts": "2.13.3",
    "date-fns": "4.1.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "tailwindcss": "3.4.15",
    "postcss": "8.4.49",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.0",
    "vitest": "2.1.5",
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/qrcode": "1.5.5",
    "@playwright/test": "1.49.0",
    "@axe-core/playwright": "4.10.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
